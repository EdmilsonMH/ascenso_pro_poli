# =====================================================
# CREDENCIALES DE SUPABASE
# =====================================================
# 
# Instrucciones:
# 1. Copia este archivo y renómbralo a .env
# 2. Ve a tu proyecto en https://supabase.com
# 3. Settings → API
# 4. Copia y pega tus credenciales aquí
#
# IMPORTANTE: No compartas este archivo con nadie
# =====================================================

# Project URL - Se ve así: https://xxxxxxxx.supabase.co
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Anon (public) key - Es una clave larga que empieza con eyJ...
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
